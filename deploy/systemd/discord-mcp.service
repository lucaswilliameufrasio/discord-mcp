[Unit]
Description=Discord MCP HTTP service (experimental)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=discord-mcp
Group=discord-mcp
StateDirectory=discord-mcp
StateDirectoryMode=0700
WorkingDirectory=/var/lib/discord-mcp
EnvironmentFile=/etc/discord-mcp/service.env
Environment=DISCORD_MCP_DB=/var/lib/discord-mcp/channels.db
Environment=DISCORD_MCP_LISTEN=127.0.0.1:8000
ExecStart=/usr/local/bin/discord-mcp serve
Restart=on-failure
RestartSec=5s
TimeoutStopSec=25s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
